# EAS archives this monorepo from its Git root.
# Keep these exclusions aligned with the corresponding .gitignore files.

# Root .gitignore
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# apps/web/.gitignore
/apps/web/**/logs
/apps/web/**/*.log
/apps/web/**/npm-debug.log*
/apps/web/**/yarn-debug.log*
/apps/web/**/yarn-error.log*
/apps/web/**/pnpm-debug.log*
/apps/web/**/lerna-debug.log*
/apps/web/**/node_modules
/apps/web/**/dist
/apps/web/**/dist-ssr
/apps/web/**/.env.local
/apps/web/**/.env.*.local
/apps/web/**/*.local
/apps/web/.vscode/*
!/apps/web/.vscode/extensions.json
/apps/web/**/.idea
/apps/web/**/.DS_Store
/apps/web/**/*.suo
/apps/web/**/*.ntvs*
/apps/web/**/*.njsproj
/apps/web/**/*.sln
/apps/web/**/*.sw?

# apps/mobile/.gitignore
/apps/mobile/**/.expo/
/apps/mobile/**/dist/
/apps/mobile/**/web-build/
/apps/mobile/**/.env
/apps/mobile/**/.env.*.local
/apps/mobile/**/expo-env.d.ts

# Mobile documentation stays in Git, outside the EAS upload.
/apps/mobile/docs/
