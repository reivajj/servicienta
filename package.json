{
  "name": "servicienta",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check-types:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "seed:users": "TSX_TSCONFIG_PATH=tsconfig.scripts.json node --import tsx scripts/cli/seed-users.ts",
    "seed:scenario": "TSX_TSCONFIG_PATH=tsconfig.scripts.json node --import tsx scripts/cli/seed-scenario.ts",
    "seed:cleanup": "TSX_TSCONFIG_PATH=tsconfig.scripts.json node --import tsx scripts/cli/cleanup-seeded-data.ts"
  },
  "dependencies": {
    "@servicienta/types": "workspace:^",
    "@supabase/supabase-js": "^2.99.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "prettier": "^3.7.4",
    "supabase": "^2.78.1",
    "tsx": "^4.21.0",
    "turbo": "^2.8.17",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
