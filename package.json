{
  "name": "servicienta",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "mobile:start": "pnpm --filter @servicienta/mobile start",
    "mobile:start:clear": "pnpm --filter @servicienta/mobile start:clear",
    "mobile:start:tunnel": "pnpm --filter @servicienta/mobile start:tunnel",
    "mobile:android": "pnpm --filter @servicienta/mobile android",
    "mobile:check-types": "pnpm --filter @servicienta/mobile check-types",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,md}\"",
    "check-types": "turbo run check-types",
    "check-types:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "seed:mobile-tomi": "TSX_TSCONFIG_PATH=tsconfig.scripts.json node --import tsx scripts/cli/seed-mobile-tomi.ts",
    "seed:users": "TSX_TSCONFIG_PATH=tsconfig.scripts.json node --import tsx scripts/cli/seed-users.ts",
    "seed:technician-profiles": "TSX_TSCONFIG_PATH=tsconfig.scripts.json node --import tsx scripts/cli/seed-technician-profiles.ts",
    "seed:scenario": "TSX_TSCONFIG_PATH=tsconfig.scripts.json node --import tsx scripts/cli/seed-scenario.ts",
    "provision:demo-accounts": "TSX_TSCONFIG_PATH=tsconfig.scripts.json node --import tsx scripts/cli/provision-demo-accounts.ts",
    "seed:cleanup": "TSX_TSCONFIG_PATH=tsconfig.scripts.json node --import tsx scripts/cli/cleanup-seeded-data.ts",
    "seed:reset-operational": "TSX_TSCONFIG_PATH=tsconfig.scripts.json node --import tsx scripts/cli/reset-operational-seed.ts",
    "mobile:apk": "pnpm --filter @servicienta/mobile apk:build"
  },
  "dependencies": {
    "@servicienta/types": "workspace:^",
    "@supabase/supabase-js": "^2.99.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "prettier": "^3.7.4",
    "supabase": "^2.98.2",
    "tsx": "^4.21.0",
    "turbo": "^2.8.17",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=18"
  }
}
