{
  "expo": {
    "name": "Servicienta",
    "slug": "servicienta",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "servicienta",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.servicienta.mobile",
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.servicienta.mobile",
      "supportsTablet": true
    }
  }
}
