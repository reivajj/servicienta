{
  "expo": {
    "name": "Servicienta",
    "slug": "servicienta",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "servicienta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.servicienta.mobile",
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.servicienta.mobile",
      "supportsTablet": true
    }
  }
}
