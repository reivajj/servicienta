{
  "expo": {
    "name": "Servicienta",
    "slug": "servicienta",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "servicienta",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.servicienta.mobile",
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.servicienta.mobile",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "owner": "reivajj",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "10a32402-845a-4b94-8238-1920ba43bed5"
      }
    }
  }
}
